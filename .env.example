# Copy to the hosting provider's secret manager. Never commit a real .env file.
# Test-mode Paymob integration currently supplied for both methods; confirm in merchant dashboard.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://eg.checkout.paymob.com/
PAYMOB_CARD_INTEGRATION_ID=6062237
PAYMOB_WALLET_INTEGRATION_ID=6062237
PAYMOB_IFRAME_ID=1094184
# Put only newly rotated values here in the deployed function secret store:
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Supabase Edge Function runtime values; do not put the service role key in frontend files.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://your-hosted-app.example
# Firebase Cloud Messaging (server-only service account JSON):
FIREBASE_PROJECT_ID=smart-laundry-7d609
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEBHOOK_SECRET=
